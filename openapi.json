{
    "openapi": "3.0.3",
    "info": {
        "title": "flowline",
        "version": "0.0.1",
        "description": "Remote support from your Nextcloud",
        "license": {
            "name": "AGPL-3.0-or-later"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/flowline/api/v1/account": {
            "get": {
                "operationId": "account-show",
                "summary": "Get the linked FlowLINE account of the current user",
                "tags": [
                    "account"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Account information returned (never includes the API token)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "anyOf": [
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "linked",
                                                                "account",
                                                                "api_url"
                                                            ],
                                                            "properties": {
                                                                "linked": {
                                                                    "type": "boolean"
                                                                },
                                                                "account": {
                                                                    "type": "object",
                                                                    "nullable": true,
                                                                    "additionalProperties": {
                                                                        "type": "object"
                                                                    }
                                                                },
                                                                "api_url": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "error"
                                                            ],
                                                            "properties": {
                                                                "error": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Not authenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {
                                                            "anyOf": [
                                                                {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "linked",
                                                                        "account",
                                                                        "api_url"
                                                                    ],
                                                                    "properties": {
                                                                        "linked": {
                                                                            "type": "boolean"
                                                                        },
                                                                        "account": {
                                                                            "type": "object",
                                                                            "nullable": true,
                                                                            "additionalProperties": {
                                                                                "type": "object"
                                                                            }
                                                                        },
                                                                        "api_url": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "error"
                                                                    ],
                                                                    "properties": {
                                                                        "error": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "FlowLINE is not enabled for this user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "anyOf": [
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "linked",
                                                                "account",
                                                                "api_url"
                                                            ],
                                                            "properties": {
                                                                "linked": {
                                                                    "type": "boolean"
                                                                },
                                                                "account": {
                                                                    "type": "object",
                                                                    "nullable": true,
                                                                    "additionalProperties": {
                                                                        "type": "object"
                                                                    }
                                                                },
                                                                "api_url": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "error"
                                                            ],
                                                            "properties": {
                                                                "error": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "account",
            "description": "API OCS consommée par la console FlowLINE (front Vue). Routes exposées via les attributs (enregistrement dynamique par Nextcloud)."
        }
    ]
}
